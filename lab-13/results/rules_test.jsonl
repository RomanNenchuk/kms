{"doc_id": "D16", "subject": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "implicit_topic": true}, "relation": "SERVES", "object": {"type": "Location", "canonical": "location:nice", "text": "Nice", "start": 368, "end": 372}, "evidence": {"text": "On 24 March 2015, the Airbus A320 operating the flight crashed 100 km (62 mi; 54 nmi) north-west of Nice in the French Alps, killing all 150 people on board.", "start": 268, "end": 425}, "modality": "asserted", "annotator": "rules", "confidence": 0.5, "provenance": {"method": "rules", "model": "spacy 3.8.18 en_core_web_sm + rules", "prompt_version": "rules-A-0.1", "doc_id": "D16", "run_id": "20261107T213728Z", "created": "2026-11-07T21:37:29+00:00"}, "qualifiers": {"time": "2015-03-24"}}
{"doc_id": "D16", "subject": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "implicit_topic": true}, "relation": "SERVES", "object": {"type": "Location", "canonical": "location:alps", "text": "Alps", "start": 387, "end": 391}, "evidence": {"text": "On 24 March 2015, the Airbus A320 operating the flight crashed 100 km (62 mi; 54 nmi) north-west of Nice in the French Alps, killing all 150 people on board.", "start": 268, "end": 425}, "modality": "asserted", "annotator": "rules", "confidence": 0.5, "provenance": {"method": "rules", "model": "spacy 3.8.18 en_core_web_sm + rules", "prompt_version": "rules-A-0.1", "doc_id": "D16", "run_id": "20261107T213728Z", "created": "2026-11-07T21:37:29+00:00"}, "qualifiers": {"time": "2015-03-24"}}
{"doc_id": "D16", "subject": {"type": "Person", "canonical": "person:andreas_lubitz", "text": "Andreas Lubitz", "start": 482, "end": 496}, "relation": "INVOLVED_IN", "object": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "implicit_topic": true}, "evidence": {"text": "The crash was deliberately caused by the first officer, Andreas Lubitz, who had previously been treated for suicidal tendencies and declared unfit to work by his doctor.", "start": 426, "end": 595}, "modality": "asserted", "annotator": "rules", "confidence": 0.5, "provenance": {"method": "rules", "model": "spacy 3.8.18 en_core_web_sm + rules", "prompt_version": "rules-A-0.1", "doc_id": "D16", "run_id": "20261107T213728Z", "created": "2026-11-07T21:37:29+00:00"}, "qualifiers": {"role": "first officer"}}
{"doc_id": "D16", "subject": {"type": "Person", "canonical": "person:lubitz", "text": "Lubitz", "start": 759, "end": 765}, "relation": "INVOLVED_IN", "object": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "implicit_topic": true}, "evidence": {"text": "Shortly after reaching cruise altitude and while the captain was out of the cockpit, Lubitz locked the cockpit door and set the plane to fly downward in a controlled descent into a mountain.", "start": 674, "end": 864}, "modality": "asserted", "annotator": "rules", "confidence": 0.5, "provenance": {"method": "rules", "model": "spacy 3.8.18 en_core_web_sm + rules", "prompt_version": "rules-A-0.1", "doc_id": "D16", "run_id": "20261107T213728Z", "created": "2026-11-07T21:37:29+00:00"}, "qualifiers": {"role": "pilot in command"}}
