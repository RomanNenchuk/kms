{"doc_id": "D16", "subject": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "text": "Germanwings Flight 9525", "start": 25, "end": 48}, "relation": "OPERATED_BY", "object": {"type": "Airline", "canonical": "airline:germanwings", "text": "Germanwings", "start": 197, "end": 208}, "evidence": {"text": "Germanwings Flight 9525 was a scheduled international passenger flight from Barcelona–El Prat Airport in Spain to Düsseldorf Airport in Germany. The flight was operated by Germanwings, a low-cost carrier owned by the German airline Lufthansa. On 24 March 2015, the Airbus A320 operating the flight crashed 100 km (62 mi; 54 nmi) north-west of Nice in the French Alps, killing all 150 people on board.", "start": 25, "end": 425}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}}
{"doc_id": "D16", "subject": {"type": "Airline", "canonical": "airline:germanwings", "text": "Germanwings", "start": 197, "end": 208}, "relation": "OWNS_STAKE_IN", "object": {"type": "Airline", "canonical": "airline:lufthansa", "text": "Lufthansa", "start": 257, "end": 266}, "evidence": {"text": "The flight was operated by Germanwings, a low-cost carrier owned by the German airline Lufthansa.", "start": 170, "end": 267}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}}
{"doc_id": "D16", "subject": {"type": "Airline", "canonical": "airline:lufthansa", "text": "Lufthansa", "start": 257, "end": 266}, "relation": "LOCATED_IN", "object": {"type": "Location", "canonical": "location:germany", "text": "Germany", "start": 161, "end": 168}, "evidence": {"text": "Germanwings Flight 9525 was a scheduled international passenger flight from Barcelona–El Prat Airport in Spain to Düsseldorf Airport in Germany. The flight was operated by Germanwings, a low-cost carrier owned by the German airline Lufthansa. On 24 March 2015, the Airbus A320 operating the flight crashed 100 km (62 mi; 54 nmi) north-west of Nice in the French Alps, killing all 150 people on board.", "start": 25, "end": 425}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}}
{"doc_id": "D16", "subject": {"type": "AircraftType", "canonical": "aircrafttype:airbus_a320", "text": "Airbus A320", "start": 290, "end": 301}, "relation": "INVOLVED_IN", "object": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "text": "Germanwings Flight 9525", "start": 25, "end": 48}, "evidence": {"text": "Germanwings Flight 9525 was a scheduled international passenger flight from Barcelona–El Prat Airport in Spain to Düsseldorf Airport in Germany. The flight was operated by Germanwings, a low-cost carrier owned by the German airline Lufthansa. On 24 March 2015, the Airbus A320 operating the flight crashed 100 km (62 mi; 54 nmi) north-west of Nice in the French Alps, killing all 150 people on board.\nThe crash was deliberately caused by the first officer, Andreas Lubitz, who had previously been treated for suicidal tendencies and declared unfit to work by his doctor.", "start": 25, "end": 595}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}, "qualifiers": {"time": "2015-03-24", "count": 150}}
{"doc_id": "D16", "subject": {"type": "Person", "canonical": "person:andreas_lubitz", "text": "Andreas Lubitz", "start": 482, "end": 496}, "relation": "INVOLVED_IN", "object": {"type": "Flight", "canonical": "flight:germanwings_flight_9525", "text": "Germanwings Flight 9525", "start": 25, "end": 48}, "evidence": {"text": "Germanwings Flight 9525 was a scheduled international passenger flight from Barcelona–El Prat Airport in Spain to Düsseldorf Airport in Germany. The flight was operated by Germanwings, a low-cost carrier owned by the German airline Lufthansa. On 24 March 2015, the Airbus A320 operating the flight crashed 100 km (62 mi; 54 nmi) north-west of Nice in the French Alps, killing all 150 people on board.\nThe crash was deliberately caused by the first officer, Andreas Lubitz, who had previously been treated for suicidal tendencies and declared unfit to work by his doctor. Lubitz kept this information from his employer and instead reported for duty.", "start": 25, "end": 673}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}}
{"doc_id": "D16", "subject": {"type": "Regulation", "canonical": "regulation:new_recommendations", "text": "new recommendations", "start": 906, "end": 925}, "relation": "ISSUED_BY", "object": {"type": "Organization", "canonical": "organization:european_union_aviation_safety_agency", "text": "European Union Aviation Safety Agency", "start": 935, "end": 972}, "evidence": {"text": "Aviation authorities swiftly implemented new recommendations from the European Union Aviation Safety Agency that required at least two authorised people to be in the cockpit at all times but, by 2017, this rule had been dropped.", "start": 865, "end": 1093}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}}
{"doc_id": "D16", "subject": {"type": "Organization", "canonical": "organization:bureau_of_enquiry_and_analysis_for_civil_aviation_safety", "text": "Bureau of Enquiry and Analysis for Civil Aviation Safety", "start": 1540, "end": 1596}, "relation": "LOCATED_IN", "object": {"type": "Location", "canonical": "location:french", "text": "French", "start": 1487, "end": 1493}, "evidence": {"text": "According to the French national civil aviation inquiries bureau, the Bureau of Enquiry and Analysis for Civil Aviation Safety (BEA), the pilots confirmed instructions from French air traffic control at 10:30 CET.", "start": 1470, "end": 1683}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D16", "run_id": "20261107T213738Z", "created": "2026-11-07T21:38:50+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2441, "tokens_out": 2001}}
{"doc_id": "D19", "subject": {"type": "AircraftType", "canonical": "aircrafttype:embraer_e_jet_e2_family", "implicit_topic": true}, "relation": "MANUFACTURED_BY", "object": {"type": "Organization", "canonical": "organization:embraer", "text": "Embraer", "start": 29, "end": 36}, "evidence": {"text": "The Embraer E-Jet E2 family is a series of four-abreast narrow-body regional jet airliners designed and produced by the Brazilian aircraft manufacturer Embraer.", "start": 25, "end": 185}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D19", "run_id": "20261107T213738Z", "created": "2026-11-07T21:39:00+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 1883, "tokens_out": 378}}
