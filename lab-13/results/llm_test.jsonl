{"doc_id": "D22", "subject": {"type": "Airline", "canonical": "airline:hagerstown_commuter", "text": "Hagerstown Commuter", "start": 1257, "end": 1276}, "relation": "AGREEMENT_WITH", "object": {"type": "Airline", "canonical": "airline:allegheny_airlines", "text": "Allegheny Airlines", "start": 1330, "end": 1348}, "evidence": {"text": "In 1967, Richard A. Henson’s Hagerstown Commuter airline joined with US Airways predecessor, regional Allegheny Airlines, in the nation's first codeshare relationship.", "start": 1228, "end": 1395}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D22", "run_id": "20261107T213738Z", "created": "2026-11-07T21:39:07+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2150, "tokens_out": 253}, "qualifiers": {"time": "1967", "kind": "codeshare"}}
{"doc_id": "D22", "subject": {"type": "Airline", "canonical": "airline:qantas", "text": "Qantas", "start": 1457, "end": 1463}, "relation": "AGREEMENT_WITH", "object": {"type": "Airline", "canonical": "airline:american_airlines", "text": "American Airlines", "start": 1468, "end": 1485}, "evidence": {"text": "The term \"code sharing\" or \"codeshare\" was coined in 1989 by Qantas and American Airlines, and in 1990 the two firms provided their first codeshare flights between an array of Australian and U.S. cities.", "start": 1396, "end": 1599}, "modality": "asserted", "annotator": "gemini", "evidence_verified": true, "provenance": {"method": "llm", "model": "gemini-3.5-flash-lite", "prompt_version": "B-v3", "doc_id": "D22", "run_id": "20261107T213738Z", "created": "2026-11-07T21:39:07+00:00", "temperature": 0.0, "seed": 42, "tokens_in": 2150, "tokens_out": 253}, "qualifiers": {"time": "1989", "kind": "codeshare"}}
