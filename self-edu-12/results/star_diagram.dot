digraph star {
  layout=twopi; root="fact_flight"; ranksep=3.0; overlap=false; splines=true;
  node [shape=plain, fontname="DejaVu Sans"]; edge [color="#555555", arrowsize=0.8, fontname="DejaVu Sans", fontsize=10];
  fact_flight [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3C58E" ALIGN="CENTER"><B>fact_flight</B></TD></TR><TR><TD ALIGN="CENTER"><I>ФАКТ · зерно: один виліт</I></TD></TR><TR><TD ALIGN="LEFT" PORT="flight_id">PK  flight_id : bigint</TD></TR><TR><TD ALIGN="LEFT" PORT="date_key">FK  date_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="origin_airport_key">FK  origin_airport_key : integer · роль: вильот</TD></TR><TR><TD ALIGN="LEFT" PORT="dest_airport_key">FK  dest_airport_key : integer · роль: призначення</TD></TR><TR><TD ALIGN="LEFT" PORT="airline_key">FK  airline_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="aircraft_key">FK  aircraft_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="delay_cause_key">FK  delay_cause_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="flight_number">      flight_number : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_dep_hour">      scheduled_dep_hour : smallint</TD></TR><TR><TD ALIGN="LEFT" PORT="distance_km">      distance_km : double · адит.</TD></TR><TR><TD ALIGN="LEFT" PORT="seats">      seats : integer · адит.</TD></TR><TR><TD ALIGN="LEFT" PORT="passengers">      passengers : integer · адит.</TD></TR><TR><TD ALIGN="LEFT" PORT="delay_minutes">      delay_minutes : integer · адит.</TD></TR><TR><TD ALIGN="LEFT" PORT="fuel_kg">      fuel_kg : double · адит.</TD></TR><TR><TD ALIGN="LEFT" PORT="revenue_usd">      revenue_usd : double · адит.</TD></TR><TR><TD ALIGN="LEFT" PORT="cancelled">      cancelled : smallint · адитивна (0/1)</TD></TR><TR><TD ALIGN="LEFT" PORT="airframe_hours">      airframe_hours : double · напівадитивна</TD></TR></TABLE>>];
  dim_date [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#BFD7EA" ALIGN="CENTER"><B>dim_date</B></TD></TR><TR><TD ALIGN="CENTER"><I>рік › квартал › місяць › день</I></TD></TR><TR><TD ALIGN="LEFT" PORT="date_key">PK  date_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="full_date">      full_date : date</TD></TR><TR><TD ALIGN="LEFT" PORT="year">      year : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="quarter">      quarter : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="month">      month : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="month_name">      month_name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="day">      day : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="day_of_week">      day_of_week : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="day_name">      day_name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="is_weekend">      is_weekend : boolean</TD></TR><TR><TD ALIGN="LEFT" PORT="season">      season : varchar</TD></TR></TABLE>>];
  dim_airport [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#BFD7EA" ALIGN="CENTER"><B>dim_airport</B></TD></TR><TR><TD ALIGN="CENTER"><I>SCD 1 · країна › місто › аеропорт</I></TD></TR><TR><TD ALIGN="LEFT" PORT="airport_key">PK  airport_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="iata">      iata : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="name">      name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="city">      city : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="country">      country : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">      latitude : double</TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">      longitude : double</TD></TR><TR><TD ALIGN="LEFT" PORT="is_hub">      is_hub : boolean</TD></TR></TABLE>>];
  dim_airline [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#BFD7EA" ALIGN="CENTER"><B>dim_airline</B></TD></TR><TR><TD ALIGN="CENTER"><I>SCD 1 · тип › авіакомпанія</I></TD></TR><TR><TD ALIGN="LEFT" PORT="airline_key">PK  airline_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="airline_code">      airline_code : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="name">      name : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="country">      country : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="airline_type">      airline_type : varchar</TD></TR></TABLE>>];
  dim_aircraft [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#BFD7EA" ALIGN="CENTER"><B>dim_aircraft</B></TD></TR><TR><TD ALIGN="CENTER"><I>SCD 2 · виробник › тип › борт</I></TD></TR><TR><TD ALIGN="LEFT" PORT="aircraft_key">PK  aircraft_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="registration">      registration : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="aircraft_type">      aircraft_type : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="manufacturer">      manufacturer : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="seats">      seats : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from">      valid_from : date</TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to">      valid_to : date</TD></TR><TR><TD ALIGN="LEFT" PORT="is_current">      is_current : boolean</TD></TR></TABLE>>];
  dim_delay_cause [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#BFD7EA" ALIGN="CENTER"><B>dim_delay_cause</B></TD></TR><TR><TD ALIGN="CENTER"><I>SCD 1 · клас › підклас (IRI)</I></TD></TR><TR><TD ALIGN="LEFT" PORT="delay_cause_key">PK  delay_cause_key : integer</TD></TR><TR><TD ALIGN="LEFT" PORT="subclass_iri">      subclass_iri : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="subclass_label">      subclass_label : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="class_iri">      class_iri : varchar</TD></TR><TR><TD ALIGN="LEFT" PORT="class_label">      class_label : varchar</TD></TR></TABLE>>];
  fact_flight:date_key -> dim_date;
  fact_flight:origin_airport_key -> dim_airport [color="#C0392B", penwidth=1.6];
  fact_flight:dest_airport_key -> dim_airport [color="#1F618D", penwidth=1.6];
  fact_flight:airline_key -> dim_airline;
  fact_flight:aircraft_key -> dim_aircraft;
  fact_flight:delay_cause_key -> dim_delay_cause;
}