{
  "openapi": "3.1.0",
  "info": {
    "title": "Aviation Knowledge Hub API",
    "description": "RAG-чат-бот з цитуванням, політикою «не знаю» та підграфом із графа знань (ЛР 11). Автентифікація: заголовок `X-API-Key`. Ролі: **viewer** (public), **analyst** (public+internal, граф), **admin** (усе).",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Стан сервісу",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "rag"
        ],
        "summary": "Запитати базу знань",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Немає або неправильний X-API-Key"
          },
          "429": {
            "description": "Перевищено ліміт запитів (заголовок Retry-After)"
          },
          "403": {
            "description": "use_graph для ролі viewer"
          },
          "502": {
            "description": "Помилка LLM-провайдера"
          },
          "503": {
            "description": "Граф або LLM тимчасово недоступні"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/sources/{source_id}": {
      "get": {
        "tags": [
          "rag"
        ],
        "summary": "Текст джерела за id",
        "description": "Ідентифікатори містять `#` (наприклад `en_aircrewc#018`): у URL його кодують як `%23`.",
        "operationId": "get_source_sources__source_id__get",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:#-]{1,100}$",
              "description": "id із поля sources",
              "title": "Source Id"
            },
            "description": "id із поля sources"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceDetail"
                }
              }
            }
          },
          "401": {
            "description": "Немає або неправильний X-API-Key"
          },
          "429": {
            "description": "Перевищено ліміт запитів (заголовок Retry-After)"
          },
          "403": {
            "description": "Рівень доступу ролі нижчий за чутливість документа"
          },
          "404": {
            "description": "Джерело не знайдено"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question",
            "description": "Питання користувача",
            "examples": [
              "What is an airline hub?"
            ]
          },
          "top_k": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Скільки контекстів із тексту передати в LLM",
            "default": 5
          },
          "use_graph": {
            "type": "boolean",
            "title": "Use Graph",
            "description": "Додати підграф із графа знань (лише ролі analyst, admin)",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained",
            "description": "true, якщо модель відповіла «не знаю» (answer тоді містить пояснення)"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Sources"
          },
          "citations": {
            "additionalProperties": true,
            "type": "object",
            "title": "Citations",
            "description": "cited — цитовані id; invalid — цитати поза наданим контекстом; ok — чи валідні"
          },
          "tokens": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tokens"
          },
          "latency_ms": {
            "additionalProperties": true,
            "type": "object",
            "title": "Latency Ms"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "access_level": {
            "type": "string",
            "title": "Access Level"
          },
          "graph_used": {
            "type": "boolean",
            "title": "Graph Used"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "answer",
          "abstained",
          "sources",
          "citations",
          "tokens",
          "latency_ms",
          "model",
          "access_level",
          "graph_used"
        ],
        "title": "AskResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "rag_loaded": {
            "type": "boolean",
            "title": "Rag Loaded"
          },
          "graph_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Graph Backend"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "rag_loaded"
        ],
        "title": "Health"
      },
      "SourceDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "sensitivity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensitivity"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "text"
        ],
        "title": "SourceDetail"
      },
      "SourceOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "text | graph"
          },
          "doc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "rerank_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rerank Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "title": "SourceOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "description": "API-ключ. Роль ключа (viewer / analyst / admin) визначає доступні документи.",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}